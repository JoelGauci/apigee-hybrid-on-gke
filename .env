# Apigee Hybrid v1.16 Runtime Configuration (.env)
# Modify these variables to customize your deployment environment without changing the script.

PROJECT_ID="apigee-h-1-16-1"
CLUSTER_NAME="apigee-hybrid"
CLUSTER_REGION="europe-west1"
NETWORK="default"
SUBNETWORK="default"

# Management Plane
APIGEE_ORG="${PROJECT_ID}" # MUST be the same as PROJECT_ID 
APIGEE_ENV="test"
APIGEE_ENV_GROUP="test-group"

# Components & Networking
DOMAIN="1.1.1.1.nip.io"
GCP_REGION="europe-west1"
APIGEE_VERSION="1.16.1"
CERT_MANAGER_VERSION="1.19.2"
APIGEE_NAMESPACE="apigee"
OVERRIDES_FILE="overrides-${APIGEE_VERSION}.yaml"

